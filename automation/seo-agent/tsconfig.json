{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"types": ["node"]
	},
	"include": ["agent/**/*.ts", "api/**/*.ts", "evals/**/*.ts", "src/**/*"]
}
