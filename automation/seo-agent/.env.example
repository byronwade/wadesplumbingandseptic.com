# Commit this file only as a variable-name reference. Never add real values.
# Local fixture and dry-run commands require no cloud credentials.
SEO_AGENT_ENV=development

# Runtime dispatch is dry-run by default outside production. On Vercel
# Production, Eve defaults to propose mode so Monday Cron can research and open
# one draft PR through Vercel Connect GitHub. Set FORCE_OBSERVE to keep audit-only.
# SEO_AGENT_FORCE_OBSERVE=false
# SEO_AGENT_RUN_MODE=observe
# SEO_AGENT_MUTATION_KILL_SWITCH=true
# SEO_AGENT_MUTATION_MODE=disabled
# Optional legacy override. Prefer standing Production propose for draft PRs.
# SEO_AGENT_NATIVE_SCHEDULE_JOB=audit
# CRON_SECRET=generate-a-random-32-character-or-longer-secret
# SEO_AGENT_DISPATCH_TIMEOUT_MS=8000
# SEO_AGENT_REPOSITORY_ROOT=/workspace/repository

# Required only for a deployed production sidecar: Vercel supplies OIDC automatically
# where supported; otherwise configure this as an encrypted Vercel Services project
# variable. Services shares project-level server environment scope: never expose it
# through NEXT_PUBLIC_ and prefer OIDC/Connect over long-lived static credentials.
# VERCEL_OIDC_TOKEN=
# AI_GATEWAY_API_KEY=
# SEO_AGENT_SANDBOX_INTEGRATION_APPROVED=false

# Required only after a human approves the first production audit for this exact run.
# SEO_AGENT_LIVE_READS_APPROVED=true
# SEO_AGENT_LIVE_READS_APPROVED_RUN_ID=first-production-audit-yyyy-mm-dd

# Optional private Blob archive. Git remains the canonical record; Blob may
# receive only the already-redacted manifest/evidence bundle after a human
# approves this exact run. Never store raw source responses or credentials.
# Attach Blob only to the eve_seo_agent service runtime. Services does not make a
# static token service-private, so do not enable it until the shared scope is approved.
# SEO_AGENT_BLOB_ENABLED=false
# SEO_AGENT_BLOB_ARCHIVE_APPROVED=false
# SEO_AGENT_BLOB_APPROVED_RUN_ID=first-production-audit-yyyy-mm-dd
# SEO_AGENT_BLOB_PREFIX=wades-eve-seo-agent/v1
# BLOB_READ_WRITE_TOKEN=

# Optional, read-only integrations. Configure only after the documented scope review.
# Search Console background runs use a dedicated service account, never a
# user-scoped Google Connect token. Store both only as Production Vercel
# secrets after a reviewed sidecar deployment. The key may use literal \n
# escapes and must never be committed, logged, or copied into Preview.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=eve-seo-reader@your-google-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# SEARCH_CONSOLE_ACCESS_TOKEN= # Legacy local-fixture fallback only. Do not use in deployment.
# PAGESPEED_API_KEY=
# GITHUB_READ_TOKEN= # Local fixture fallback only. Deployed GitHub reads use Vercel Connect.
# SEO_AGENT_GITHUB_CONNECTOR_ID=github/wadesplumbingandseptic-com
# VERCEL_READ_TOKEN=
# VERCEL_READ_PROJECT_ID=
# VERCEL_READ_TEAM_ID=
# Community browser research is automatic in standing Production propose.
# Eve uses versioned community/holiday hosts; no owner toggle is required.
# SEO_AGENT_BROWSER_RESEARCH_ENABLED=true
# SEO_AGENT_BROWSER_ALLOWED_DOMAINS=

# Credentialed analytics adapters remain blocked until credentials exist.
# A missing credential is BLOCKED_MISSING_CREDENTIALS, never a silent skip of Eve decisions.
# SEO_AGENT_ENABLE_AI_GATEWAY=false
# SEO_AGENT_ENABLE_GITHUB=false
# SEO_AGENT_ENABLE_VERCEL=false
# SEO_AGENT_ENABLE_SEARCH_CONSOLE=false
# SEO_AGENT_ENABLE_PAGESPEED=false
# SEO_AGENT_ENABLE_BROWSERBASE=false
# SEO_AGENT_ENABLE_GA4=false
# SEO_AGENT_ENABLE_BUSINESS_PROFILE=false
# SEO_AGENT_ENABLE_LOCAL_FALCON=false
# SEO_AGENT_ENABLE_SIMILARWEB=false
# SEO_AGENT_ENABLE_GOOGLE_TRENDS=false

# Optional read-only integrations. Never commit values or generated .env files.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# GA4: prefer existing Google service account + property id (see MANUAL_SETUP.md).
# GA4_PROPERTY_ID=
# GA4_ACCESS_TOKEN=
# GOOGLE_BUSINESS_PROFILE_ACCESS_TOKEN=
# GOOGLE_BUSINESS_PROFILE_LOCATION_ID=
# LOCAL_FALCON_API_KEY=
# SIMILARWEB_API_KEY=
# GOOGLE_TRENDS_ACCESS_TOKEN=
