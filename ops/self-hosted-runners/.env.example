# Copy to .env and fill in ONE of ACCESS_TOKEN or RUNNER_TOKEN.
#
# Recommended: fine-grained PAT or classic PAT with repo administration so
# ephemeral runners can re-register automatically.
#
# Classic PAT scopes: repo (private) or public_repo + admin:repo_hook
# Fine-grained: Repository permissions → Administration: Read and write
#               (needed to create runners)

REPO_URL=https://github.com/byronwade/wades-plumbing-and-septic
RUNNER_SCOPE=repo

# Preferred for docker compose fleets:
ACCESS_TOKEN=

# Alternative short-lived token from the GitHub UI (expires ~1 hour):
RUNNER_TOKEN=

# Ephemeral runners deregister after each job (recommended).
EPHEMERAL=true

# Scale overrides used by up.sh
CI_REPLICAS=2
QUALITY_REPLICAS=2
