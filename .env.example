# Copy to `.env.local` for local development. Never commit real tokens.

# Vercel Blob read/write token (Production/Preview).
# Required for durable page-view popularity counts in serverless.
# Dashboard: Storage → Blob → store → .env.local
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Optional: store id from the Blob UI (SDK uses the token alone).
# BLOB_READ_WRITE_TOKEN_STORE_ID=
