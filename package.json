{
	"name": "wades-plumbing-and-septic",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"audit:react-scan": "npx react-scan@latest localhost:3000",
		"audit:shadscan": "npx @shadscan/cli",
		"audit:vercel-doctor": "npx -y vercel-doctor@latest .",
		"biome": "biome check .",
		"prebuild": "node scripts/sync-maplibre-worker.mjs && node scripts/strip-next-polyfills.mjs",
		"build": "next build",
		"check": "npm run lint && npm run typecheck && npm run format:check && npm run ci:glossary && npm run ci:search && npm run ci:archive && npm run ci:related && npm run ci:page-views && npm run ci:city-service && npm run ci:sitemap && npm run ci:service-sections && npm run ci:og && npm run ci:seo-meta && npm run build",
		"ci:archive": "tsx scripts/ci/test-archive.ts && tsx scripts/ci/audit-archive-filters.ts",
		"ci:city-service": "tsx scripts/ci/validate-city-service-pages.ts",
		"ci:content": "node scripts/ci/validate-content.mjs",
		"ci:glossary": "node scripts/ci/validate-glossary.mjs",
		"ci:images": "tsx scripts/ci/test-image-delivery.ts",
		"ci:og": "tsx scripts/ci/test-og.ts",
		"ci:page-views": "tsx scripts/ci/test-page-views.ts",
		"ci:related": "tsx scripts/ci/test-related-content.ts",
		"ci:search": "tsx scripts/ci/test-search.ts",
		"ci:self-hosted-policy": "node scripts/ci/assert-self-hosted-only.mjs",
		"ci:seo-meta": "tsx scripts/ci/test-seo-meta.ts",
		"ci:service-sections": "tsx scripts/ci/test-service-sections.ts",
		"ci:sitemap": "tsx scripts/ci/test-sitemap.ts",
		"dev": "next dev",
		"doctor": "npx react-doctor@latest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "node scripts/sync-maplibre-worker.mjs",
		"knip": "knip",
		"lint": "eslint . --max-warnings=0",
		"migrate:wayback": "python3 -u scripts/migrate-from-wayback.py",
		"seo:check": "npm run ci:content && npm run ci:glossary && npm run ci:city-service && npm run ci:sitemap && npm run ci:service-sections && npm run ci:og && npm run ci:images && npm run ci:seo-meta",
		"seo:hygiene": "node scripts/seo/fix-content-hygiene.mjs",
		"seo-agent:control-plane": "node automation/seo-agent/scripts/verify-control-plane.mjs",
		"seo-agent:verify": "npm run seo-agent:control-plane && node scripts/verify-seo-agent.mjs",
		"start": "next start",
		"test:verification-core": "node --test scripts/verification-core.test.mjs scripts/verify-completion.test.mjs",
		"typecheck": "tsc --noEmit",
		"ultracite:check": "ultracite check",
		"ultracite:fix": "ultracite fix",
		"verify:all": "node scripts/verify-all.mjs",
		"verify:completion": "node scripts/verify-completion.mjs"
	},
	"browserslist": [
		"chrome >= 111",
		"edge >= 111",
		"firefox >= 111",
		"safari >= 16.4",
		"not dead"
	],
	"overrides": {
		"postcss": "8.5.25"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-navigation-menu": "1.2.22",
		"@radix-ui/react-separator": "1.1.15",
		"@radix-ui/react-slot": "1.3.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.6.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"evlog": "^2.22.4",
		"gray-matter": "4.0.3",
		"maplibre-gl": "^6.0.0",
		"next": "16.3.0-preview.10",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.3",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@tailwindcss/postcss": "4.3.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.0-preview.10",
		"knip": "^6.32.0",
		"postcss": "8.5.25",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "0.8.1",
		"react-doctor": "^0.9.5",
		"react-scan": "^0.5.7",
		"tailwindcss": "4.3.3",
		"tsx": "^4.21.0",
		"typescript": "6.0.3",
		"ultracite": "^7.10.1"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
