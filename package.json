{
	"name": "wades-plumbing-and-septic",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"prebuild": "node scripts/sync-maplibre-worker.mjs",
		"build": "next build",
		"start": "next start",
		"postinstall": "node scripts/sync-maplibre-worker.mjs",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"ci:content": "node scripts/ci/validate-content.mjs",
		"ci:city-service": "npx --yes tsx scripts/ci/validate-city-service-pages.mjs",
		"ci:self-hosted-policy": "node scripts/ci/assert-self-hosted-only.mjs",
		"ci:search": "npx --yes tsx scripts/ci/test-search.ts",
		"ci:archive": "npx --yes tsx scripts/ci/test-archive.ts",
		"ci:related": "npx --yes tsx scripts/ci/test-related-content.ts",
		"migrate:wayback": "python3 -u scripts/migrate-from-wayback.py",
		"migrate:wordpress": "python3 -u scripts/migrate-from-wordpress-csv.py",
		"migrate:wordpress-images": "python3 -u scripts/migrate-wordpress-images.py",
		"check": "npm run lint && npm run typecheck && npm run format:check && npm run ci:search && npm run ci:archive && npm run ci:related && npm run ci:city-service && npm run build",
		"seo:hygiene": "node scripts/seo/fix-content-hygiene.mjs"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.10",
		"@radix-ui/react-accordion": "1.2.20",
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-navigation-menu": "1.2.22",
		"@radix-ui/react-separator": "1.1.15",
		"@radix-ui/react-slot": "1.3.3",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@vercel/analytics": "^2.0.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"gray-matter": "4.0.3",
		"maplibre-gl": "^6.0.0",
		"next": "16.3.0-preview.10",
		"next-themes": "0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"sonner": "2.0.7",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.0-preview.10",
		"postcss": "8.5.6",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
