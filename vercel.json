{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"crons": [
		{
			"path": "/_internal/eve/api/live-probe/search-console",
			"schedule": "0 0 1 1 *"
		},
		{
			"path": "/_internal/eve/api/live-probe/pagespeed",
			"schedule": "0 0 1 1 *"
		},
		{
			"path": "/_internal/eve/api/live-probe/search-console-topics",
			"schedule": "0 0 1 1 *"
		},
		{
			"path": "/_internal/eve/api/live-probe/pagespeed-qa",
			"schedule": "0 0 1 1 *"
		},
		{
			"path": "/_internal/eve/api/live-probe/browser-research",
			"schedule": "0 0 1 1 *"
		},
		{
			"path": "/_internal/eve/api/live-probe/ga4",
			"schedule": "0 0 1 1 *"
		}
	],
	"services": {
		"site": {
			"root": ".",
			"framework": "nextjs",
			"installCommand": "npm ci --ignore-scripts --omit=peer",
			"buildCommand": "npm run build"
		},
		"eve_seo_agent": {
			"root": "automation/seo-agent",
			"installCommand": "npm ci --ignore-scripts --omit=peer",
			"buildCommand": "npm run build",
			"routes": [
				{
					"src": "/_internal/eve/(.*)",
					"transforms": [
						{
							"type": "request.path",
							"op": "set",
							"args": "/$1"
						}
					]
				}
			]
		}
	},
	"rewrites": [
		{
			"source": "/eve/v1/cron/(.*)",
			"destination": {
				"service": "eve_seo_agent",
				"path": "/eve/v1/cron/$1"
			}
		},
		{
			"source": "/_internal/eve/(.*)",
			"destination": {
				"service": "eve_seo_agent",
				"path": "/$1"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "site"
			}
		}
	]
}
