{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Wade's SEO change manifest",
	"type": "object",
	"required": [
		"schema_version",
		"id",
		"query_cluster",
		"owner_url",
		"existing_page_assessment",
		"evidence_ids",
		"fact_check",
		"internal_links",
		"technical_seo",
		"qa",
		"rollback_target"
	],
	"properties": {
		"schema_version": { "const": "1.0" },
		"id": { "type": "string", "minLength": 1 },
		"query_cluster": { "type": "string", "minLength": 1 },
		"owner_url": { "type": "string", "pattern": "^/" },
		"existing_page_assessment": {
			"enum": ["EXISTING_SUFFICIENT", "EXISTING_INSUFFICIENT"]
		},
		"evidence_ids": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string" }
		},
		"fact_check": { "enum": ["APPROVED", "REJECTED"] },
		"internal_links": { "type": "array" },
		"technical_seo": { "type": "object" },
		"qa": { "enum": ["APPROVED", "REJECTED"] },
		"rollback_target": { "type": "string", "minLength": 1 }
	},
	"additionalProperties": false
}
